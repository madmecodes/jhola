// Jhola household ordering schema.
// Items are checked one line at a time (purchase_item).
// Payment is checked for the whole order (auto_pay / request_approval / approved_pay).

entity Household;

entity Member in [Household] {
  name: String,
  role: String, // admin | adult | house_help | teen | elder
  // Personal limits set by the admin (optional). Above a cap the admin must approve.
  daily_cap_inr?: Long,
  order_cap_inr?: Long,
  allowed_categories?: Set<String>, // when present it replaces the role's category scope
  // Temporary delegation ("Didi can spend 1500 this week"): valid while context.today <= delegated_until.
  delegated_cap_inr?: Long,
  delegated_until?: Long, // yyyymmdd
  // Dietary profile (checked against the member the order is FOR, context.beneficiary).
  diet_profile: String, // none | veg | vegan | jain | eggetarian
  allergies: Set<String>, // peanut, tree_nut, milk, gluten, soy, egg, sesame, mustard
  vrat_until?: Long, // yyyymmdd: fasting (vrat) mode until this date, only vrat_friendly food
  max_caffeine_mg?: Long, // caffeine allowed per order (one energy drink is about 80 mg)
};

entity Product {
  name: String,
  brand: String,
  category: String,
  tags: Set<String>, // lowercase English / Hinglish words, e.g. "chocolate", "atta", "energy"
  price_inr: Long,
  seller_rating: decimal,
  // From the catalog's diet / allergen data (false / empty for non-food).
  is_food: Bool,
  veg: Bool,
  vegan: Bool,
  jain_friendly: Bool, // no onion, garlic, root vegetables
  vrat_friendly: Bool, // allowed during a Navratri fast
  eggetarian_only: Bool, // the only non-veg part is egg
  allergens: Set<String>,
  contains: Set<String>, // onion, garlic, added_sugar, caffeine, palm_oil, ...
  caffeine_mg: Long, // per serving, 0 if none
};

entity Mandate {
  monthly_cap_inr: Long,
  approval_threshold_inr: Long,
  house_help_daily_cap_inr: Long,
};

action purchase_item appliesTo {
  principal: [Member],
  resource: [Product],
  context: {
    quantity: Long,
    line_total_inr: Long,
    today: Long, // yyyymmdd in IST, e.g. 20260920
    beneficiary: Member, // the member the item is FOR (the principal unless "Dadi ke liye")
    order_caffeine_mg: Long, // caffeine in this order for the beneficiary (all caffeinated lines)
  },
};

action auto_pay, request_approval, approved_pay appliesTo {
  principal: [Member],
  resource: [Mandate],
  context: {
    order_total_inr: Long,
    month_spent_inr: Long,
    member_spent_today_inr: Long,
    approver_role: String, // "" unless an admin approved this order
    today: Long, // yyyymmdd in IST, e.g. 20260920
    member_spent_delegated_inr: Long, // paid by this member since their delegation started (0 if none)
  },
};
